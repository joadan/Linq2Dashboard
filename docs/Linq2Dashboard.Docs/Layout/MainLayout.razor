@inherits LayoutComponentBase

<div class="site">
    <header class="site-header">
        <a class="site-brand" href="">Linq2Dashboard</a>
        <nav class="site-nav">
            <NavLink href="" Match="NavLinkMatch.All">Overview</NavLink>
            <NavLink href="demo">Demo</NavLink>
            <NavLink href="getting-started">Getting started</NavLink>
            <NavLink href="concept">Concept</NavLink>
            <NavLink href="design">Design</NavLink>
            <a href="https://github.com/joadan/Linq2Dashboard" target="_blank" rel="noopener">GitHub</a>
        </nav>
    </header>

    <main class="site-main @(IsWide ? "site-main-wide" : null)">
        @Body
    </main>

    <footer class="site-footer">
        Linq2Dashboard is MIT licensed. This site runs on Blazor WebAssembly; the dashboard is built and recalculated in your browser.
    </footer>
</div>
