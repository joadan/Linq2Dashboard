@inject HttpClient Http
@using Markdig

@* Renders one of the repository's markdown documents, copied into wwwroot/docs at build time. *@

@if (error is not null)
{
    <p class="markdown-error">@error</p>
}
else if (html is null)
{
    <p class="markdown-loading">Loading…</p>
}
else
{
    <article class="markdown">@html</article>
}
