@page "/demo"
@inject NavigationManager Navigation

<PageTitle>Demo · Linq2Dashboard</PageTitle>

<div class="demo-toolbar">
    <h1>Demo</h1>
    <label class="demo-rows">
        Rows
        <select value="@rows" @onchange="OnRowsChanged" disabled="@building">
            @foreach (int option in RowOptions)
            {
                <option value="@option">@option.ToString("N0")</option>
            }
        </select>
    </label>
    @if (generateMilliseconds is long generated && buildMilliseconds is long built)
    {
        <span class="demo-timing">generated in @generated.ToString("N0") ms · dashboard built in @built.ToString("N0") ms</span>
    }
</div>

<p class="demo-note">
    This demo runs entirely in your browser on Blazor WebAssembly so it can be hosted as a static site. That is the
    slow way to run it: a single interpreted or ahead-of-time compiled thread, and every row held in browser memory.
    On Blazor Server, the primary target, the same library builds a million rows in about a second and recalculates
    in 5 to 20 ms on a 4-core machine. Treat the timings here as an upper bound.
</p>

@if (dashboard is null)
{
    <p class="demo-building">Generating @rows.ToString("N0") orders and building the dashboard in your browser…</p>
}
else
{
    <DashboardView T="SampleOrder" Dashboard="dashboard" Selections="selections" SelectionsChanged="OnSelectionsChanged">
        <div class="demo-layout">
            <aside class="demo-facets">
                <ValueFacet T="SampleOrder" Key="Country" />
                <ValueFacet T="SampleOrder" Key="Status" ShowTotals="true" />
                <ValueFacet T="SampleOrder" Key="Category" />
                <ValueFacet T="SampleOrder" Key="Customer" Collapsed="true" />
                <ValueFacet T="SampleOrder" Key="IsActive" HideZeroCounts="true" />
                <RangeFacet T="SampleOrder" Key="Amount" ShowSlider="true" />
                <DateFacet T="SampleOrder" Key="OrderDate" />
            </aside>
            <div class="demo-main">
                <div class="demo-status">
                    <CalculationTiming />
                </div>
                <ActiveSelections T="SampleOrder" />
                <div class="demo-metrics">
                    <MatchingCount T="SampleOrder" Title="Orders matching" ShowShare="true">
                        <Icon><DemoIcon Name="cart" /></Icon>
                    </MatchingCount>
                    <Metric T="SampleOrder" Key="revenue" ShowShare="true">
                        <Icon><DemoIcon Name="banknote" /></Icon>
                    </Metric>
                    <Metric T="SampleOrder" Key="average">
                        <Icon><DemoIcon Name="receipt" /></Icon>
                    </Metric>
                    <Metric T="SampleOrder" Key="customers" ShowShare="true">
                        <Icon><DemoIcon Name="users" /></Icon>
                    </Metric>
                    <Metric T="SampleOrder" Key="perCustomer">
                        <Icon><DemoIcon Name="trend" /></Icon>
                    </Metric>
                </div>
                <Results T="SampleOrder" Layout="ResultsLayout.Table" Virtualize="true" ItemSize="33">
                    <HeaderTemplate>
                        <tr>
                            <th>Id</th>
                            <th>Date</th>
                            <th>Country</th>
                            <th>Status</th>
                            <th>Customer</th>
                            <th class="demo-number">Amount</th>
                        </tr>
                    </HeaderTemplate>
                    <RowTemplate Context="order">
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.OrderDate?.ToString("yyyy-MM-dd")</td>
                            <td>@order.Country</td>
                            <td>@order.Status</td>
                            <td>@(order.Customer ?? "–")</td>
                            <td class="demo-number">@(order.Amount?.ToString("N2") ?? "–")</td>
                        </tr>
                    </RowTemplate>
                </Results>
                <details class="demo-json">
                    <summary>Selections as JSON, also kept in the URL</summary>
                    <pre>@dashboard.Serializer.ToJson(selections, indented: true)</pre>
                </details>
            </div>
        </div>
    </DashboardView>
}
