@page "/demo"
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Demo · Linq2Dashboard</PageTitle>

<div class="demo-toolbar">
    <h1>Demo</h1>
    <label class="demo-rows">
        Rows
        <select value="@rows" @onchange="OnRowsChanged" disabled="@building">
            @foreach (int option in RowOptions)
            {
                <option value="@option">@option.ToString("N0")</option>
            }
        </select>
    </label>
    @if (generateMilliseconds is long generated && buildMilliseconds is long built)
    {
        <span class="demo-timing">generated in @generated.ToString("N0") ms · dashboard built in @built.ToString("N0") ms</span>
    }
</div>

@if (!noteDismissed)
{
    <div class="demo-note" role="note">
        <p>
            This demo runs entirely in your browser on Blazor WebAssembly so it can be hosted as a static site. That is the
            slow way to run it: a single interpreted or ahead-of-time compiled thread, and every row held in browser memory.
            On Blazor Server, the primary target, the same library builds a million rows in about a second and recalculates
            in 5 to 20 ms on a 4-core machine. Treat the timings here as an upper bound.
        </p>
        <button type="button" class="demo-note-close" title="Hide this note" aria-label="Hide this note" @onclick="DismissNoteAsync">&times;</button>
    </div>
}

@if (dashboard is null)
{
    <p class="demo-building">Generating @rows.ToString("N0") orders and building the dashboard in your browser…</p>
}
else
{
    <DashboardView T="SampleOrder" @ref="view" Context="dash" Dashboard="dashboard" Formatter="DemoFormatter.Instance" SyncUrl="true" Selections="selections" SelectionsChanged="OnSelectionsChanged" StateChanged="OnStateChanged">
        <div class="demo-layout">
            <aside class="demo-facets">
                <TextFacet T="SampleOrder" Key="search" Placeholder="Customer or channel" />
                @* A per-facet cap: the list scrolls inside itself, the header stays. Set the property on the dashboard instead to cap every facet. *@
                <ValueFacet T="SampleOrder" Key="Country" style="--l2d-facet-max-height: 12rem" />
                @* A value template: the page renders the inside of each value button, the library keeps the button, its click and its selected state. *@
                <ValueFacet T="SampleOrder" Key="Status">
                    <ValueTemplate Context="value"><DemoStatus Value="value" /></ValueTemplate>
                </ValueFacet>
                <ValueFacet T="SampleOrder" Key="Channel" />
                <ValueFacet T="SampleOrder" Key="Customer" Collapsed="true" />
                <ValueFacet T="SampleOrder" Key="IsActive" HideZeroCounts="true" />
                <RangeFacet T="SampleOrder" Key="Amount" ShowSlider="true" />
                <DateFacet T="SampleOrder" Key="OrderDate" />
            </aside>
            <div class="demo-main">
                <ActiveSelections T="SampleOrder" />
                <div class="demo-metrics">
                    <Metric T="SampleOrder" Key="orders" Name="Orders matching">
                        <MetricTemplate Context="tile"><DemoTile Content="tile" Icon="cart" /></MetricTemplate>
                    </Metric>
                    <Metric T="SampleOrder" Key="revenue">
                        <MetricTemplate Context="tile"><DemoTile Content="tile" Icon="banknote" /></MetricTemplate>
                    </Metric>
                    <Metric T="SampleOrder" Key="average">
                        <MetricTemplate Context="tile"><DemoTile Content="tile" Icon="receipt" /></MetricTemplate>
                    </Metric>
                    <Metric T="SampleOrder" Key="customers">
                        <MetricTemplate Context="tile"><DemoTile Content="tile" Icon="users" /></MetricTemplate>
                    </Metric>
                    <Metric T="SampleOrder" Key="perCustomer">
                        <MetricTemplate Context="tile"><DemoTile Content="tile" Icon="trend" /></MetricTemplate>
                    </Metric>
                </div>
                @* The page's own chart, drawn from the state that StateChanged delivers. Nothing in the library knows it exists. *@
                <section class="demo-chart">
                    <div class="demo-chart-header">
                        <span class="demo-chart-title">Orders per month</span>
                        <span class="demo-chart-note">drawn by the page from <code>StateChanged</code> · click months to toggle them</span>
                    </div>
                    @if (timeline is not null)
                    {
                        <div class="demo-chart-bars @(timeline.HasSelection ? "demo-chart-has-selection" : null)">
                            @foreach (DateBucket bucket in timeline.Buckets)
                            {
                                <button type="button"
                                        class="demo-chart-bar @(bucket.Selected ? "demo-chart-selected" : null)"
                                        style="--total: @Share(bucket.TotalCount); --filtered: @Share(bucket.FilteredCount)"
                                        title="@BarTitle(bucket)"
                                        @onclick="() => OnBarClicked(bucket)">
                                    <span class="demo-chart-total"></span>
                                    <span class="demo-chart-filtered"></span>
                                </button>
                            }
                        </div>
                        <div class="demo-chart-axis">
                            @foreach (DateBucket bucket in timeline.Buckets)
                            {
                                <span>@(bucket.PeriodStart.Month == 1 ? bucket.PeriodStart.Year.ToString() : null)</span>
                            }
                        </div>
                    }
                </section>
                @* The rows go to a grid of the page's choosing, here QuickGrid: dash.Items is one IQueryable per state, so the grid re-queries exactly when the state changes. *@
                <div class="demo-grid">
                    <QuickGrid Items="dash.Items" Virtualize="true" ItemSize="22">
                        <PropertyColumn Property="o => o.Id" Sortable="true" />
                        <PropertyColumn Property="o => o.OrderDate" Title="Date" Format="yyyy-MM-dd" Sortable="true" />
                        <PropertyColumn Property="o => o.Country" Sortable="true" />
                        <PropertyColumn Property="o => o.Status" Sortable="true" />
                        <PropertyColumn Property="o => o.Customer" Sortable="true" />
                        <PropertyColumn Property="o => o.Amount" Format="N2" Align="Align.Right" Sortable="true" />
                    </QuickGrid>
                </div>
                <div class="demo-status">
                    <CalculationTiming />
                </div>
                <details class="demo-json">
                    <summary>Selections as JSON and as the URL query</summary>
                    <pre>@dashboard.Serializer.ToJson(selections, indented: true)</pre>
                    <pre>?@dashboard.Serializer.ToQueryString(selections)</pre>
                </details>
            </div>
        </div>
    </DashboardView>
}
