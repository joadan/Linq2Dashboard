@page "/"
@rendermode InteractiveServer
@inject Dashboard<SampleOrder> Dashboard

<PageTitle>Linq2Dashboard sample</PageTitle>

<h1>Orders</h1>

<div class="sample-scope">
    <label>
    Scope
    <select @bind="scope">
        <option value="">All countries</option>
        @foreach (string country in countries)
        {
            <option value="@country">@country</option>
        }
        @if (pinned is not null)
        {
            <option value="@PinnedScope">Pinned view (@pinned.TotalCount.ToString("N0") rows)</option>
        }
    </select>
    </label>
    <button type="button" class="sample-pin" disabled="@(!CanPin)" title="Make the current selections the scope of a new dashboard" @onclick="Pin">Scope to selection</button>
    <span class="sample-scope-note">The same dashboard over a subset of the rows, through <code>Dashboard.ScopeTo</code>. Totals follow the scope; selections carry over. <code>ScopeTo(selections)</code> turns the current view into a dashboard of its own.</span>
</div>

<DashboardView T="SampleOrder" Context="dash" Dashboard="Scoped" SyncUrl="true" @bind-Selections="selections">
    <div class="sample-layout">
        <aside class="sample-facets">
            <TextFacet T="SampleOrder" Key="search" Placeholder="Customer or channel" />
            <ValueFacet T="SampleOrder" Key="Country" />
            <ValueFacet T="SampleOrder" Key="Status" />
            <ValueFacet T="SampleOrder" Key="Channel" />
            <ValueFacet T="SampleOrder" Key="Customer" Collapsed="true" />
            <ValueFacet T="SampleOrder" Key="IsActive" HideZeroCounts="true" />
            <RangeFacet T="SampleOrder" Key="Amount" ShowSlider="true" />
            <DateFacet T="SampleOrder" Key="OrderDate" />
        </aside>
        <main class="sample-main">
           
            <ActiveSelections T="SampleOrder" />

            <div class="sample-metrics">
                <Metric T="SampleOrder" Key="orders" />
                <Metric T="SampleOrder" Key="revenue" />
                <Metric T="SampleOrder" Key="average" />
                <Metric T="SampleOrder" Key="customers" />
                <Metric T="SampleOrder" Key="perCustomer" />
            </div>
                        
            <div class="sample-grid">
                <QuickGrid Items="dash.Items" Virtualize="true" ItemSize="22">
                    <PropertyColumn Property="o => o.Id" Sortable="true" />
                    <PropertyColumn Property="o => o.OrderDate" Title="Date" Format="yyyy-MM-dd" Sortable="true" />
                    <PropertyColumn Property="o => o.Country" Sortable="true" />
                    <PropertyColumn Property="o => o.Status" Sortable="true" />
                    <PropertyColumn Property="o => o.Customer" Sortable="true" />
                    <PropertyColumn Property="o => o.Amount" Format="N2" Align="Align.Right" Sortable="true" />
                </QuickGrid>
            </div>

            <details>
                <summary>Raw state</summary>
                <StateSummary T="SampleOrder" />
            </details>
        </main>
    </div>
</DashboardView>

<details>
    <summary>Selections as JSON and as the URL query</summary>
    <pre>@Dashboard.Serializer.ToJson(selections, indented: true)</pre>
    <pre>?@Dashboard.Serializer.ToQueryString(selections)</pre>
</details>
