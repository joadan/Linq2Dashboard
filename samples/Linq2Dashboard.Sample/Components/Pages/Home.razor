@page "/"
@rendermode InteractiveServer
@inject OrdersDashboardService Dashboards

<PageTitle>Linq2Dashboard sample</PageTitle>

<h1>Orders</h1>

@if (dashboard is null)
{
    <p>Loading orders...</p>
    return;
}

<p class="sample-links">Interactive Server, over one dashboard that a cache service, <code>OrdersDashboardService</code>, builds on the first request and shares with every user. The same dashboard under <a href="/static">static server-side rendering</a>, where every click is a link. For the simple case, <a href="/small">a small dataset per page</a>: the view builds its own dashboard with the facets defined in markup, and nothing is cached.</p>

<div class="sample-scope">
    <label>
    Scope
    <select @bind="scope">
        <option value="">All countries</option>
        @foreach (string country in countries)
        {
            <option value="@country">@country</option>
        }
        @if (pinned is not null)
        {
            <option value="@PinnedScope">Pinned view (@pinned.TotalCount.ToString("N0") rows)</option>
        }
    </select>
    </label>
    <button type="button" class="sample-pin" disabled="@(!CanPin)" title="Make the current selections the scope of a new dashboard" @onclick="Pin">Scope to selection</button>
    <span class="sample-scope-note">The same dashboard over a subset of the rows, through <code>Dashboard.ScopeTo</code>. Totals follow the scope; selections carry over. <code>ScopeTo(selections)</code> turns the current view into a dashboard of its own.</span>
</div>

<DashboardView T="SampleOrder" Context="dash" Dashboard="Scoped" SyncUrl="true" @bind-Selections="selections">
    <div class="sample-layout">
        <aside class="sample-facets">
            <TextFacet T="SampleOrder" Key="@SampleOrderKeys.Search" Placeholder="Customer or channel" />
            <ValueFacet T="SampleOrder" For="x => x.Country" style="--l2d-facet-max-height: 12rem" />
            <ValueFacet T="SampleOrder" For="x => x.Status" />
            <ValueFacet T="SampleOrder" For="x => x.Channel" />
            <ValueFacet T="SampleOrder" For="x => x.Tags" />
            <ValueFacet T="SampleOrder" Key="@SampleOrderKeys.Customer" Collapsed="true" />
            <ValueFacet T="SampleOrder" For="x => x.IsActive" HideZeroCounts="true" />
            <RangeFacet T="SampleOrder" For="x => x.Amount" ShowSlider="true" />
            <DateFacet T="SampleOrder" For="x => x.OrderDate" />
        </aside>
        <main class="sample-main">
           
            <ActiveSelections T="SampleOrder" />

            <div class="sample-metrics">
                <Metric T="SampleOrder" Key="@SampleOrderKeys.Orders" />
                <Metric T="SampleOrder" Key="@SampleOrderKeys.Revenue" />
                <Metric T="SampleOrder" Key="@SampleOrderKeys.Average" />
                <Metric T="SampleOrder" Key="@SampleOrderKeys.Customers" />
                <Metric T="SampleOrder" Key="@SampleOrderKeys.PerCustomer" />
            </div>
                        
            <div class="sample-grid">
                <QuickGrid Items="dash.Items" Virtualize="true" ItemSize="22">
                    <PropertyColumn Property="o => o.Id" Sortable="true" />
                    <PropertyColumn Property="o => o.OrderDate" Title="Date" Format="yyyy-MM-dd" Sortable="true" />
                    <PropertyColumn Property="o => o.Country" Sortable="true" />
                    <PropertyColumn Property="o => o.Status" Sortable="true" />
                    <PropertyColumn Property="o => o.Customer" Sortable="true" />
                    <TemplateColumn Title="Tags">@string.Join(", ", context.Tags ?? [])</TemplateColumn>
                    <PropertyColumn Property="o => o.Amount" Format="N2" Align="Align.Right" Sortable="true" />
                </QuickGrid>
            </div>

            <details>
                <summary>Raw state</summary>
                <StateSummary T="SampleOrder" />
            </details>
        </main>
    </div>
</DashboardView>

<details>
    <summary>Selections as JSON and as the URL query</summary>
    <pre>@Dashboard.Serializer.ToJson(selections, indented: true)</pre>
    <pre>?@Dashboard.Serializer.ToQueryString(selections)</pre>
</details>
