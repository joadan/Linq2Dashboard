@typeparam T
@inherits DashboardComponentBase<T>

<div @attributes="AdditionalAttributes" class="@RootClass("l2d-summary")">
    <p class="l2d-summary-counts">
        <strong class="l2d-matching">@Formatter.FormatCount(State.MatchingCount)</strong> @OfText
        <span class="l2d-total">@Formatter.FormatCount(State.TotalCount)</span>
        @if (!State.Selections.IsEmpty)
        {
            <Clickable Class="l2d-clear-all" Href="@LinkTo(_ => Linq2Dashboard.Selections.Empty)" OnClick="() => Context.ClearAllAsync()">@ClearAllText</Clickable>
        }
    </p>

    @if (State.Metrics.Count > 0)
    {
        <dl class="l2d-summary-metrics">
            @foreach (MetricState metric in State.Metrics)
            {
                <dt>@metric.Name</dt>
                <dd class="l2d-metric" data-key="@metric.Key">@Formatter.FormatMetric(metric)</dd>
            }
        </dl>
    }

    @foreach (FacetState facet in State.Facets)
    {
        string key = facet.Key;
        <section class="l2d-summary-facet" data-key="@facet.Key">
            <h4>
                @facet.Name
                @if (facet.HasSelection)
                {
                    <Clickable Class="l2d-clear" Href="@LinkTo(s => s.Clear(key))" OnClick="() => Context.ClearAsync(key)">@ClearText</Clickable>
                }
            </h4>
            <ul>
                @switch (facet)
                {
                    case ValueFacetState values:
                        @foreach (FacetValue value in values.Values)
                        {
                            <li class="@(value.Selected ? "l2d-selected" : null)">
                                <Clickable Class="l2d-value" Href="@LinkTo(s => s.Toggle(key, value.Value))" OnClick="() => Context.ToggleAsync(key, value.Value)">
                                    @Formatter.FormatValue(facet, value.Value)
                                </Clickable>
                                <span class="l2d-count">@Formatter.FormatCount(value.FilteredCount) <span class="l2d-count-total">(@Formatter.FormatCount(value.TotalCount))</span></span>
                            </li>
                        }
                        @if (values.Other is FacetCount other)
                        {
                            <li class="l2d-other">@OtherText <span class="l2d-count">@Formatter.FormatCount(other.FilteredCount) <span class="l2d-count-total">(@Formatter.FormatCount(other.TotalCount))</span></span></li>
                        }
                        break;

                    case RangeFacetState range:
                        @foreach (RangeBucket bucket in range.Buckets)
                        {
                            <li class="@(bucket.Selected ? "l2d-selected" : null)">
                                <Clickable Class="l2d-value" Href="@LinkTo(s => s.ToggleInterval(key, bucket.ToInterval()))" OnClick="() => Context.ToggleIntervalAsync(key, bucket.ToInterval())">
                                    @Formatter.FormatRangeBucket(bucket)
                                </Clickable>
                                <span class="l2d-count">@Formatter.FormatCount(bucket.FilteredCount) <span class="l2d-count-total">(@Formatter.FormatCount(bucket.TotalCount))</span></span>
                            </li>
                        }
                        @if (range.Null.TotalCount > 0)
                        {
                            <li class="@(range.Null.Selected ? "l2d-selected" : null)">
                                <Clickable Class="l2d-value" Href="@NullHref(range)" OnClick="() => ToggleNull(range)">
                                    @Formatter.NullLabel
                                </Clickable>
                                <span class="l2d-count">@Formatter.FormatCount(range.Null.FilteredCount) <span class="l2d-count-total">(@Formatter.FormatCount(range.Null.TotalCount))</span></span>
                            </li>
                        }
                        break;

                    case DateFacetState dates:
                        @foreach (PresetState preset in dates.Presets)
                        {
                            <li class="l2d-preset @(preset.Selected ? "l2d-selected" : null)">
                                <Clickable Class="l2d-value" Href="@LinkTo(s => s.ToggleInterval(key, preset.ToInterval()))" OnClick="() => Context.ToggleIntervalAsync(key, preset.ToInterval())">
                                    @Formatter.FormatPreset(preset.Preset)
                                </Clickable>
                                <span class="l2d-count">@Formatter.FormatCount(preset.FilteredCount) <span class="l2d-count-total">(@Formatter.FormatCount(preset.TotalCount))</span></span>
                            </li>
                        }
                        @foreach (DateBucket bucket in dates.Buckets)
                        {
                            <li class="@(bucket.Selected ? "l2d-selected" : null)">
                                <Clickable Class="l2d-value" Href="@LinkTo(s => s.ToggleInterval(key, bucket.ToInterval()))" OnClick="() => Context.ToggleIntervalAsync(key, bucket.ToInterval())">
                                    @Formatter.FormatDateBucket(bucket, dates.Granularity)
                                </Clickable>
                                <span class="l2d-count">@Formatter.FormatCount(bucket.FilteredCount) <span class="l2d-count-total">(@Formatter.FormatCount(bucket.TotalCount))</span></span>
                            </li>
                        }
                        @if (dates.Null.TotalCount > 0)
                        {
                            <li class="@(dates.Null.Selected ? "l2d-selected" : null)">
                                <Clickable Class="l2d-value" Href="@NullHref(dates)" OnClick="() => ToggleNull(dates)">
                                    @Formatter.NullLabel
                                </Clickable>
                                <span class="l2d-count">@Formatter.FormatCount(dates.Null.FilteredCount) <span class="l2d-count-total">(@Formatter.FormatCount(dates.Null.TotalCount))</span></span>
                            </li>
                        }
                        break;
                }
            </ul>
        </section>
    }
</div>
