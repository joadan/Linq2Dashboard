@* Dual-handle slider over [Min, Max]. Two native range inputs overlap; the thumbs take pointer events, the tracks do not.
   Values preview while dragging and apply on release, so the dashboard recalculates once per gesture. *@

<div class="l2d-slider" style="--l2d-slider-from: @Percent(from); --l2d-slider-to: @Percent(to);">
    <div class="l2d-slider-track">
        <div class="l2d-slider-fill"></div>
        <input type="range" class="l2d-slider-from" min="@Text(Min)" max="@Text(Max)" step="@Text(Step)" value="@Text(from)"
               aria-label="@FromLabel" @oninput="e => PreviewFrom(e.Value)" @onchange="e => ApplyFrom(e.Value)" />
        <input type="range" class="l2d-slider-to" min="@Text(Min)" max="@Text(Max)" step="@Text(Step)" value="@Text(to)"
               aria-label="@ToLabel" @oninput="e => PreviewTo(e.Value)" @onchange="e => ApplyTo(e.Value)" />
    </div>
    @if (ShowInputs)
    {
        <div class="l2d-slider-inputs">
            <input type="number" class="@CssClasses.Input("l2d-slider-input-from", InputClass)" min="@Text(Min)" max="@Text(Max)" step="@Text(Step)" value="@Text(from)"
                   aria-label="@FromLabel" @onchange="e => ApplyFrom(e.Value)" />
            <span class="l2d-slider-separator">–</span>
            <input type="number" class="@CssClasses.Input("l2d-slider-input-to", InputClass)" min="@Text(Min)" max="@Text(Max)" step="@Text(Step)" value="@Text(to)"
                   aria-label="@ToLabel" @onchange="e => ApplyTo(e.Value)" />
        </div>
    }
    else
    {
        <div class="l2d-slider-values">@Formatter.FormatRangeSelection(RangeSelection.Between(from, to))</div>
    }
</div>
