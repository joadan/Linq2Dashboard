@typeparam T
@inject NavigationManager Navigation

<CascadingValue Value="context" IsFixed="true">
    <div @attributes="AdditionalAttributes" class="@RootClass" data-key="@Key">
        @if (ChildContent is null)
        {
            <StateSummary T="T" />
        }
        else
        {
            @ChildContent
        }
    </div>
</CascadingValue>
