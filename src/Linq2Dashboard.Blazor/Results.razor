@typeparam T
@inherits DashboardComponentBase<T>

<div class="l2d-results">
    @if (State.MatchingCount == 0)
    {
        <div class="l2d-results-empty">
            @if (EmptyTemplate is not null)
            {
                @EmptyTemplate
            }
            else
            {
                @EmptyText
            }
        </div>
    }
    else
    {
        ResultPage<T> page = CurrentPage();

        @if (ShowSummary)
        {
            <p class="l2d-results-summary">
                @string.Format(SummaryFormat,
                    Formatter.FormatCount(page.PageIndex * page.PageSize + 1),
                    Formatter.FormatCount(page.PageIndex * page.PageSize + page.Items.Count),
                    Formatter.FormatCount(page.MatchingCount))
            </p>
        }

        @if (Layout == ResultsLayout.Table)
        {
            <table class="l2d-results-table">
                @if (HeaderTemplate is not null)
                {
                    <thead>@HeaderTemplate</thead>
                }
                <tbody>
                    @foreach (T item in page.Items)
                    {
                        @RowTemplate(item)
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="l2d-results-list">
                @if (HeaderTemplate is not null)
                {
                    @HeaderTemplate
                }
                @foreach (T item in page.Items)
                {
                    @RowTemplate(item)
                }
            </div>
        }

        @if (page.PageCount > 1)
        {
            <nav class="l2d-pager" aria-label="@PagerLabel">
                <button type="button" class="l2d-pager-first" disabled="@(!page.HasPrevious)" @onclick="() => GoTo(0)">«</button>
                <button type="button" class="l2d-pager-previous" disabled="@(!page.HasPrevious)" @onclick="() => GoTo(page.PageIndex - 1)">‹</button>
                <span class="l2d-pager-status">@string.Format(PageFormat, Formatter.FormatCount(page.PageIndex + 1), Formatter.FormatCount(page.PageCount))</span>
                <button type="button" class="l2d-pager-next" disabled="@(!page.HasNext)" @onclick="() => GoTo(page.PageIndex + 1)">›</button>
                <button type="button" class="l2d-pager-last" disabled="@(!page.HasNext)" @onclick="() => GoTo(page.PageCount - 1)">»</button>
            </nav>
        }
    }
</div>

@code {
    private int pageIndex;
    private Selections? pageSelections;

    /// <summary>Renders one matching row. Required: the core cannot know what a row looks like (design §9).</summary>
    [Parameter, EditorRequired]
    public RenderFragment<T> RowTemplate { get; set; } = default!;

    /// <summary>Rendered once before the rows. In <see cref="ResultsLayout.Table"/> it goes inside <c>thead</c> and should render a <c>tr</c>.</summary>
    [Parameter]
    public RenderFragment? HeaderTemplate { get; set; }

    /// <summary>Rendered when no row matches. Defaults to <see cref="EmptyText"/>.</summary>
    [Parameter]
    public RenderFragment? EmptyTemplate { get; set; }

    /// <summary>A plain list of row fragments, or a table with the rows inside <c>tbody</c>.</summary>
    [Parameter]
    public ResultsLayout Layout { get; set; } = ResultsLayout.List;

    [Parameter]
    public int PageSize { get; set; } = 50;

    /// <summary>The page the component starts on and, through the callback, the one it is on.</summary>
    [Parameter]
    public int PageIndex { get; set; }

    [Parameter]
    public EventCallback<int> PageIndexChanged { get; set; }

    [Parameter]
    public bool ShowSummary { get; set; } = true;

    /// <summary>Format for the summary line; {0} first row, {1} last row, {2} matching count.</summary>
    [Parameter]
    public string SummaryFormat { get; set; } = "Showing {0}–{1} of {2}";

    /// <summary>Format for the pager status; {0} current page, {1} page count.</summary>
    [Parameter]
    public string PageFormat { get; set; } = "Page {0} of {1}";

    [Parameter]
    public string EmptyText { get; set; } = "No matching rows";

    [Parameter]
    public string PagerLabel { get; set; } = "Pages";

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(RowTemplate);
        ArgumentOutOfRangeException.ThrowIfLessThan(PageSize, 1);
        ArgumentOutOfRangeException.ThrowIfNegative(PageIndex);
        pageIndex = PageIndex;
    }

    /// <summary>A new state means new matching rows: go back to the first page (design §9).</summary>
    protected override void OnDashboardStateChanged()
    {
        if (!State.Selections.Equals(pageSelections))
        {
            pageIndex = 0;
        }
    }

    private ResultPage<T> CurrentPage()
    {
        pageSelections = State.Selections;
        int last = Math.Max(0, State.PageCount(PageSize) - 1);
        pageIndex = Math.Clamp(pageIndex, 0, last);
        return State.GetPage(pageIndex, PageSize);
    }

    private Task GoTo(int index)
    {
        pageIndex = Math.Max(0, index);
        return PageIndexChanged.InvokeAsync(pageIndex);
    }
}
