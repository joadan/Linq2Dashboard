@typeparam T
@inherits FacetComponentBase<T>

<section @attributes="AdditionalAttributes" class="@RootClass($"l2d-facet l2d-range-facet l2d-range-{Layout.ToString().ToLowerInvariant()}{(collapsed ? " l2d-collapsed" : "")}")" data-key="@ResolvedKey">
    @if (HeaderTemplate is not null)
    {
        @HeaderTemplate(Facet)
    }
    else
    {
        <FacetHeader Name="@HeaderName" ShowClear="Facet.HasSelection" ClearText="@ClearText" OnClear="() => Context.ClearAsync(ResolvedKey)" ClearHref="@LinkTo(s => s.Clear(ResolvedKey))"
                     Collapsible="Collapsible" Collapsed="collapsed" OnToggle="ToggleCollapsed">
            @if (ShowBounds && !double.IsNaN(Facet.Min))
            {
                <span class="l2d-facet-bounds">@Formatter.FormatRangeInterval(RangeInterval.Between(Facet.Min, Facet.Max))</span>
            }
        </FacetHeader>
    }

    @if (collapsed)
    {
    }
    else if (Facet.Buckets.Count == 0 && Facet.Null.TotalCount == 0)
    {
        <p class="l2d-facet-empty">@NoValuesText</p>
    }
    else
    {
        <BucketBars Bars="Bars()" Formatter="Formatter" Layout="Layout" ShowCounts="ShowCounts" ShowTotals="ShowTotals" />

        @if (ShowSlider && !double.IsNaN(Facet.Min) && Facet.Max > Facet.Min)
        {
            <RangeSlider Min="Facet.Min" Max="Facet.Max" From="SliderFrom" To="SliderTo" Step="SliderStep"
                         Formatter="Formatter" ShowInputs="ShowSliderInputs" InputClass="@InputClass" OnChange="ApplySlider" />
        }
    }
</section>
