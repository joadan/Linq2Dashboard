@typeparam T
@inherits DashboardComponentBase<T>

<section @attributes="AdditionalAttributes" class="@RootClass($"l2d-facet l2d-date-facet l2d-date-{Layout.ToString().ToLowerInvariant()}{(collapsed ? " l2d-collapsed" : "")}")" data-key="@Key">
    @if (HeaderTemplate is not null)
    {
        @HeaderTemplate(Facet)
    }
    else
    {
        <FacetHeader Name="@HeaderName" ShowClear="Facet.HasSelection" ClearText="@ClearText" OnClear="() => Context.ClearAsync(Key)"
                     Collapsible="Collapsible" Collapsed="collapsed" OnToggle="ToggleCollapsed" />
    }

    @if (collapsed)
    {
    }
    else if (ShowPresets && Facet.Presets.Count > 0)
    {
        <ul class="l2d-presets">
            @foreach (PresetState preset in Facet.Presets)
            {
                <li class="l2d-preset @(preset.Selected ? "l2d-selected" : null) @(preset.FilteredCount == 0 ? "l2d-zero" : null)">
                    <button type="button" class="l2d-preset-button" aria-pressed="@(preset.Selected ? "true" : "false")"
                            title="@CountText.Tooltip(Formatter, preset.FilteredCount, preset.TotalCount)"
                            @onclick="() => ClickPreset(preset)">
                        <span class="l2d-preset-label">@Formatter.FormatPreset(preset.Preset)</span>
                        @if (ShowCounts)
                        {
                            <span class="l2d-preset-count">
                                @Formatter.FormatCount(preset.FilteredCount)@if (ShowTotals) {<span class="l2d-preset-total"> (@Formatter.FormatCount(preset.TotalCount))</span>}
                            </span>
                        }
                    </button>
                </li>
            }
        </ul>
    }

    @if (collapsed)
    {
    }
    else if (Facet.Buckets.Count == 0 && Facet.Null.TotalCount == 0)
    {
        <p class="l2d-facet-empty">@NoValuesText</p>
    }
    else
    {
        <BucketBars Bars="Bars()" Formatter="Formatter" Layout="Layout" ShowCounts="ShowCounts" ShowTotals="ShowTotals" />
    }
</section>
