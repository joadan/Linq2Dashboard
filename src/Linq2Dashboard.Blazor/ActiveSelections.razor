@typeparam T
@inherits DashboardComponentBase<T>

@if (State.Selections.IsEmpty)
{
    @if (!HideWhenEmpty)
    {
        <div @attributes="AdditionalAttributes" class="@RootClass("l2d-active l2d-active-empty")">@EmptyText</div>
    }
}
else
{
    <div @attributes="AdditionalAttributes" class="@RootClass("l2d-active")">
        <ul class="l2d-active-chips">
            @foreach (FacetState facet in State.Facets)
            {
                @switch (facet.Selection)
                {
                    case null:
                        break;

                    case ValueSelection values when GroupValues:
                        @* One chip per facet: the values are one OR group (concept §4.1). Each value stays removable on its own. *@
                        <li class="l2d-chip l2d-chip-group" data-key="@facet.Key">
                            @if (ShowFacetTitle)
                            {
                                <span class="l2d-chip-facet">@facet.Title</span>
                            }
                            <span class="l2d-chip-values">
                                @for (int i = 0; i < values.Values.Count; i++)
                                {
                                    object? value = values.Values[i];
                                    string label = Formatter.FormatValue(facet, value);
                                    @if (i > 0)
                                    {
                                        <span class="l2d-chip-separator">@ValueSeparator</span>
                                    }
                                    <span class="l2d-chip-value">
                                        <span class="l2d-chip-label">@label</span>
                                        <button type="button" class="l2d-chip-value-remove" aria-label="@RemoveText @label" title="@RemoveText"
                                                @onclick="() => Context.ToggleAsync(facet.Key, value)">×</button>
                                    </span>
                                }
                            </span>
                            <button type="button" class="l2d-chip-remove" aria-label="@RemoveText @facet.Title" title="@RemoveText"
                                    @onclick="() => Context.ClearAsync(facet.Key)">×</button>
                        </li>
                        break;

                    case ValueSelection values:
                        @* One chip per value; removing it toggles that value off. *@
                        @foreach (object? value in values.Values)
                        {
                            object? captured = value;
                            string label = Formatter.FormatValue(facet, value);
                            <li class="l2d-chip" data-key="@facet.Key">
                                @if (ShowFacetTitle)
                                {
                                    <span class="l2d-chip-facet">@facet.Title</span>
                                }
                                <span class="l2d-chip-label">@label</span>
                                <button type="button" class="l2d-chip-remove" aria-label="@RemoveText @label" title="@RemoveText"
                                        @onclick="() => Context.ToggleAsync(facet.Key, captured)">×</button>
                            </li>
                        }
                        break;

                    default:
                        @* Range and date facets hold one interval; removing the chip clears the facet. *@
                        <li class="l2d-chip" data-key="@facet.Key">
                            @if (ShowFacetTitle)
                            {
                                <span class="l2d-chip-facet">@facet.Title</span>
                            }
                            <span class="l2d-chip-label">@IntervalLabel(facet)</span>
                            <button type="button" class="l2d-chip-remove" aria-label="@RemoveText @facet.Title" title="@RemoveText"
                                    @onclick="() => Context.ClearAsync(facet.Key)">×</button>
                        </li>
                        break;
                }
            }
        </ul>
        <button type="button" class="l2d-active-clear-all" @onclick="() => Context.ClearAllAsync()">@ClearAllText</button>
    </div>
}
