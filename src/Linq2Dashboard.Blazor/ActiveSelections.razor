@typeparam T
@inherits DashboardComponentBase<T>

@if (State.Selections.IsEmpty)
{
    @if (!HideWhenEmpty)
    {
        <div @attributes="AdditionalAttributes" class="@RootClass("l2d-active l2d-active-empty")">@EmptyText</div>
    }
}
else
{
    <div @attributes="AdditionalAttributes" class="@RootClass("l2d-active")">
        <ul class="l2d-active-chips">
            @foreach (FacetState facet in State.Facets)
            {
                IReadOnlyList<ChipPart> parts = Parts(facet);
                @if (parts.Count == 0)
                {
                    continue;
                }

                @if (GroupValues && parts.Count > 1)
                {
                    @* One chip per facet: the parts are one OR group (concept §4.1). Each part stays removable on its own. *@
                    <li @key="facet.Key" class="l2d-chip l2d-chip-group" data-key="@facet.Key">
                        @if (ShowFacetName)
                        {
                            <span class="l2d-chip-facet">@facet.Name</span>
                        }
                        <span class="l2d-chip-values">
                            @for (int i = 0; i < parts.Count; i++)
                            {
                                ChipPart part = parts[i];
                                @if (i > 0)
                                {
                                    <span class="l2d-chip-separator">@ValueSeparator</span>
                                }
                                <span class="l2d-chip-value">
                                    <span class="l2d-chip-label">@part.Label</span>
                                    <button type="button" class="l2d-chip-value-remove" aria-label="@RemoveText @part.Label" title="@RemoveText"
                                            @onclick="part.Remove">×</button>
                                </span>
                            }
                        </span>
                        <button type="button" class="l2d-chip-remove" aria-label="@RemoveText @facet.Name" title="@RemoveText"
                                @onclick="() => Context.ClearAsync(facet.Key)">×</button>
                    </li>
                }
                else
                {
                    @* One chip per part; removing it removes that part, which clears the facet when it was the last one. *@
                    @foreach (ChipPart part in parts)
                    {
                        <li @key="(facet.Key, part.Label)" class="l2d-chip" data-key="@facet.Key">
                            @if (ShowFacetName)
                            {
                                <span class="l2d-chip-facet">@facet.Name</span>
                            }
                            <span class="l2d-chip-label">@part.Label</span>
                            <button type="button" class="l2d-chip-remove" aria-label="@RemoveText @part.Label" title="@RemoveText"
                                    @onclick="part.Remove">×</button>
                        </li>
                    }
                }
            }
        </ul>
        <button type="button" class="l2d-active-clear-all" aria-label="@ClearAllText" title="@ClearAllText" @onclick="() => Context.ClearAllAsync()">×</button>
    </div>
}
