@typeparam T
@inherits DashboardComponentBase<T>

<div class="l2d-metrics">
    @if (IncludeMatchingCount)
    {
        <MatchingCount T="T" Title="@MatchingCountTitle" />
    }
    @foreach (MetricState metric in Shown)
    {
        <Metric T="T" Key="@metric.Key" MetricTemplate="MetricTemplate" />
    }
</div>
