@typeparam T
@inherits DashboardComponentBase<T>

@if (MetricTemplate is not null)
{
    @MetricTemplate(Content)
}
else
{
    <MetricTile Class="@Class" AdditionalAttributes="AdditionalAttributes" Key="@Key" Name="@Content.Name" Value="@Content.Value" Share="@Content.Share" IsEmpty="@Content.IsEmpty" />
}
