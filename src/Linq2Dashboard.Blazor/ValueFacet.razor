@typeparam T
@inherits DashboardComponentBase<T>

<section class="l2d-facet l2d-value-facet" data-key="@Key">
    <header class="l2d-facet-header">
        <h3 class="l2d-facet-title">@Facet.Title</h3>
        @if (Facet.HasSelection)
        {
            <button type="button" class="l2d-facet-clear" @onclick="() => Context.ClearAsync(Key)">@ClearText</button>
        }
    </header>

    @if (Facet.IsSearchable)
    {
        <input type="search" class="l2d-facet-search" placeholder="@SearchPlaceholder" value="@searchText"
               @oninput="e => searchText = e.Value?.ToString() ?? string.Empty" />
    }

    <ul class="l2d-facet-values">
        @foreach (FacetValue value in Displayed)
        {
            <li class="l2d-facet-value @(value.Selected ? "l2d-selected" : null) @(value.FilteredCount == 0 ? "l2d-zero" : null) @(value.IsNull ? "l2d-null" : null)">
                <button type="button" class="l2d-facet-value-button" aria-pressed="@(value.Selected ? "true" : "false")"
                        title="@Formatter.FormatCount(value.FilteredCount) / @Formatter.FormatCount(value.TotalCount)"
                        @onclick="() => Context.ToggleAsync(Key, value.Value)">
                    <span class="l2d-facet-value-label">@Formatter.FormatValue(Facet, value.Value)</span>
                    <span class="l2d-facet-value-count">
                        @Formatter.FormatCount(value.FilteredCount)@if (ShowTotals) {<span class="l2d-facet-value-total"> / @Formatter.FormatCount(value.TotalCount)</span>}
                    </span>
                </button>
            </li>
        }
        @if (!IsSearching && Facet.Other is FacetCount other)
        {
            <li class="l2d-facet-other">
                <span class="l2d-facet-value-label">@OtherText</span>
                <span class="l2d-facet-value-count">
                    @Formatter.FormatCount(other.FilteredCount)@if (ShowTotals) {<span class="l2d-facet-value-total"> / @Formatter.FormatCount(other.TotalCount)</span>}
                </span>
            </li>
        }
        @if (IsSearching && !Displayed.Any())
        {
            <li class="l2d-facet-empty">@NoMatchesText</li>
        }
    </ul>
</section>

@code {
    private string searchText = string.Empty;

    /// <summary>The facet key, as defined in the builder. Must be a value or boolean facet.</summary>
    [Parameter, EditorRequired]
    public string Key { get; set; } = default!;

    /// <summary>Leave out values whose filtered count is zero. Off by default: the core keeps them (concept §4.3) and the UI decides.</summary>
    [Parameter]
    public bool HideZeroCounts { get; set; }

    /// <summary>Show "filtered / total" instead of the filtered count alone.</summary>
    [Parameter]
    public bool ShowTotals { get; set; }

    /// <summary>Maximum number of search results (concept §4.5).</summary>
    [Parameter]
    public int SearchLimit { get; set; } = 20;

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search";

    [Parameter]
    public string ClearText { get; set; } = "Clear";

    [Parameter]
    public string OtherText { get; set; } = "Other";

    [Parameter]
    public string NoMatchesText { get; set; } = "No matches";

    private ValueFacetState Facet => State.Facet(Key) as ValueFacetState
        ?? throw new InvalidOperationException($"Facet '{Key}' is not a value or boolean facet; use the component for its kind.");

    private bool IsSearching => Facet.IsSearchable && searchText.Length > 0;

    private IEnumerable<FacetValue> Displayed
    {
        get
        {
            IEnumerable<FacetValue> values = IsSearching ? Facet.Search(searchText, SearchLimit) : Facet.Values;
            return HideZeroCounts ? values.Where(v => v.FilteredCount > 0 || v.Selected) : values;
        }
    }
}
