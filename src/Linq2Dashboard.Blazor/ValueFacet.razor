@typeparam T
@inherits DashboardComponentBase<T>

<section @attributes="AdditionalAttributes" class="@RootClass($"l2d-facet l2d-value-facet{(collapsed ? " l2d-collapsed" : "")}")" data-key="@Key">
    @if (HeaderTemplate is not null)
    {
        @HeaderTemplate(Facet)
    }
    else
    {
        <FacetHeader Name="@HeaderName" ShowClear="Facet.HasSelection" ClearText="@ClearText" OnClear="() => Context.ClearAsync(Key)"
                     Collapsible="Collapsible" Collapsed="collapsed" OnToggle="ToggleCollapsed" />
    }

    @if (!collapsed)
    {
        @if (Facet.IsSearchable)
        {
            <input type="search" class="@CssClasses.Input("l2d-facet-search", InputClass)" placeholder="@SearchPlaceholder" value="@searchText"
                   @oninput="e => searchText = e.Value?.ToString() ?? string.Empty" />
        }

        <ul class="l2d-facet-values">
            @foreach (FacetValue value in Displayed)
            {
                <li class="l2d-facet-value @(value.Selected ? "l2d-selected" : null) @(value.FilteredCount == 0 ? "l2d-zero" : null) @(value.IsNull ? "l2d-null" : null)">
                    <button type="button" class="l2d-facet-value-button" aria-pressed="@(value.Selected ? "true" : "false")"
                            title="@CountText.Tooltip(Formatter, value.FilteredCount, value.TotalCount)"
                            @onclick="() => Context.ToggleAsync(Key, value.Value)">
                        @if (ValueTemplate is not null)
                        {
                            @ValueTemplate(value)
                        }
                        else
                        {
                            <span class="l2d-facet-value-label">@Formatter.FormatValue(Facet, value.Value)</span>
                            <span class="l2d-facet-value-count">
                                @Formatter.FormatCount(value.FilteredCount)@if (ShowTotals) {<span class="l2d-facet-value-total"> (@Formatter.FormatCount(value.TotalCount))</span>}
                            </span>
                        }
                    </button>
                </li>
            }
            @if (!IsSearching && Facet.Other is FacetCount other)
            {
                <li class="l2d-facet-other">
                    <span class="l2d-facet-value-label">@OtherText</span>
                    <span class="l2d-facet-value-count">
                        @Formatter.FormatCount(other.FilteredCount)@if (ShowTotals) {<span class="l2d-facet-value-total"> (@Formatter.FormatCount(other.TotalCount))</span>}
                    </span>
                </li>
            }
            @if (IsSearching && !Displayed.Any())
            {
                <li class="l2d-facet-empty">@NoMatchesText</li>
            }
        </ul>
    }
</section>
