@* The default header of every facet component: name (a toggle when collapsible), optional extra content, an × that clears the facet when selected. *@

<header class="l2d-facet-header @(Collapsible ? "l2d-collapsible" : null) @(Collapsed ? "l2d-collapsed" : null)">
    @if (Collapsible)
    {
        <button type="button" class="l2d-facet-toggle" aria-expanded="@(Collapsed ? "false" : "true")" @onclick="OnToggle">
            <svg class="l2d-facet-chevron" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M2 3.5 5 6.5 8 3.5" /></svg>
            <h3 class="l2d-facet-title">@Name</h3>
        </button>
    }
    else
    {
        <h3 class="l2d-facet-title">@Name</h3>
    }
    @ChildContent
    @if (ShowClear)
    {
        <Clickable Class="l2d-facet-clear" AriaLabel="@ClearText" Title="@ClearText" Href="@ClearHref" OnClick="OnClear">×</Clickable>
    }
</header>
