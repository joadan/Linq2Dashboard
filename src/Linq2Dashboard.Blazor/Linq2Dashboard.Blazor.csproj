<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Linq2Dashboard.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Linq2Dashboard.Blazor</PackageId>
    <Description>Blazor components for Linq2Dashboard: value, range and date facets, active-selection chips, metric tiles and paged or virtualised results over a DashboardState. Plain CSS with custom properties; one formatter for culture.</Description>
    <PackageTags>blazor;blazor-components;faceted-search;facets;dashboard;linq</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Linq2Dashboard\Linq2Dashboard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Linq2Dashboard.Blazor.Tests" />
  </ItemGroup>

</Project>
