<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Linq2Dashboard.Blazor</RootNamespace>
    <PackageId>Linq2Dashboard.Blazor</PackageId>
    <Description>Blazor components for Linq2Dashboard: facets, metrics and paged results over a DashboardState.</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Linq2Dashboard\Linq2Dashboard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Linq2Dashboard.Blazor.Tests" />
  </ItemGroup>

</Project>
