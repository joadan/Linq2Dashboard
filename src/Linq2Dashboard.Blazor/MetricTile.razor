@* The tile shared by Metric and MatchingCount: a title over a value, or custom content. *@

<div @attributes="AdditionalAttributes" class="@RootClass" data-key="@Key">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <span class="l2d-metric-title">@Title</span>
        <span class="l2d-metric-value">@Value</span>
        @if (Share is not null)
        {
            <span class="l2d-metric-share">@Share</span>
        }
    }
</div>
